      "blocks": [
        {
          "type": "feed",
          "source": "watchlist",
          "view": "home",
          "title": "À voir / À écouter",
          "display": "grid"
        }
      ],
      "heading": "À garder pour plus tard."
    },
    {
      "id": "favorites",
      "screen": "favorites",
      "label": "Favoris",
      "icon": "heart",
      "placement": "personal",
      "blocks": [
        {
          "type": "feed",
          "source": "favorites",
          "view": "home",
          "title": "Favoris",
          "display": "grid"
        }
      ],
      "heading": "Les histoires qui restent."
    }
  ],
  "theme": {}
