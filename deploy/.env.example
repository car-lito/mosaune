# Exemple fictif à adapter. Ce fichier ne contient aucune clé ni mot de passe.
MOSAUNE_PUBLIC_URL=https://192.168.1.50:47831
MOSAUNE_BIND_IP=192.168.1.50
MOSAUNE_HOST_PORT=47831
MOSAUNE_DATA_PATH=/DATA/AppData/mosaune/data
MOSAUNE_TLS_PATH=/DATA/AppData/mosaune/tls
MOSAUNE_MEDIA_PATH=/DATA/Media
MOSAUNE_UID=65532
MOSAUNE_GID=65532
# Si certificat issu d'une autorité locale : /tls/ca.crt ; sinon laisser vide.
MOSAUNE_TLS_CA=/tls/ca.crt
TZ=Europe/Brussels
